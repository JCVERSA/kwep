#!/usr/bin/env python3
import os
import sys
import random
import time
import signal
from datetime import datetime

# Nom du fichier témoin caché
FILE_NAME = ".idx_heartbeat.tmp"

def cleanup_and_exit(signum=None, frame=None):
    """Supprime proprement le fichier temporaire lors de la fermeture."""
    if os.path.exists(FILE_NAME):
        try:
            os.remove(FILE_NAME)
            print(f"\n[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] [INFO] Fichier nettoyé. Arrêt propre.", flush=True)
        except Exception:
            pass
    sys.exit(0)

# Capture des signaux Linux pour l'arrêt propre
signal.signal(signal.SIGINT, cleanup_and_exit)
signal.signal(signal.SIGTERM, cleanup_and_exit)

def keep_alive_final():
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{timestamp}] [START] Script anti-veille finalisé et actif.", flush=True)
    
    consecutive_errors = 0
    
    while True:
        try:
            current_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            
            # 1. Simulation d'activité CPU légitime (Calcul rapide)
            _ = [random.randint(1, 1000) for _ in range(5000)]
            
            # 2. Simulation d'activité Disque (Écriture)
            with open(FILE_NAME, "w", encoding="utf-8") as file:
                file.write(f"Dernier heartbeat valide : {current_time}\n")
            
            # Réinitialisation du compteur d'erreurs en cas de succès
            if consecutive_errors > 0:
                print(f"[{current_time}] [INFO] Retour à la normale. Système opérationnel.", flush=True)
            consecutive_errors = 0
            
            # Intervalle variable (entre 5 et 10 minutes)
            sleep_duration = random.randint(300, 600)
            time.sleep(sleep_duration)

        except IOError as e:
            consecutive_errors += 1
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            print(f"[{timestamp}] [ERREUR I/O #{consecutive_errors}]: {e}", file=sys.stderr, flush=True)
            
            # Sécurité si l'espace disque est saturé par exemple
            if consecutive_errors > 5:
                time.sleep(600)  # Pause de 10 minutes pour calmer le système
            else:
                time.sleep(30)

        except Exception as e:
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            print(f"[{timestamp}] [ERREUR INCONNUE]: {e}", file=sys.stderr, flush=True)
            time.sleep(60)

if __name__ == "__main__":
    keep_alive_final()
