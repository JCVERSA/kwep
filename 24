#!/usr/bin/env python3

import os
import random
import time
from datetime import datetime

def display_banner():
    print(r"""
    ======================================
    |       IDX Keep-Alive Smart         |
    |          Version Discrète          |
    ======================================
    """)

def keep_alive_smart():
    # On utilise un seul fichier caché pour simuler l'activité
    file_name = ".idx_heartbeat.tmp"
    
    print("[*] Script de maintien d'activité démarré avec succès.")
    
    while True:
        try:
            current_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            
            # On écrit juste une ligne avec l'heure actuelle dans un seul fichier
            with open(file_name, "w") as file:
                file.write(f"Heartbeat ok at {current_time}\n")
            
            print(f"[{current_time}] Activité simulée (Fichier mis à jour).")
            
            # Optionnel : 10% de chance de supprimer le fichier pour ne pas laisser de traces constantes
            if random.random() < 0.1 and os.path.exists(file_name):
                os.remove(file_name)

            # IDX coupe après ~15-30 min d'inactivity. 
            # On attend un temps aléatoire entre 4 et 8 minutes (plus naturel pour un humain)
            sleep_duration = random.randint(240, 480)
            print(f"[*] Prochaine simulation dans {sleep_duration // 60} minutes et {sleep_duration % 60} secondes...")
            time.sleep(sleep_duration)

        except Exception as e:
            print(f"[-] Une erreur est survenue : {e}")
            time.sleep(60) # En cas d'erreur, on attend 1 minute avant de réessayer

if __name__ == "__main__":
    display_banner()
    keep_alive_smart()
